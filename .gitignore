# ===== 框架/依赖 =====
/nbproject/
/thinkphp/
/vendor/
/runtime/*
!/runtime/.gitkeep
!/runtime/.htaccess
/addons/*
!/addons/.gitkeep
/public/assets/libs/
/public/assets/addons/*
/public/uploads/*
!/public/uploads/.gitkeep
composer.lock

# ===== 环境/配置（含密码） =====
.env
.user.ini

# ===== IDE =====
.DS_Store
.idea/
.svn
.vscode/

# ===== 构建产物 =====
node_modules/
*.log
*.css.map
!.gitkeep

# ===== 临时数据 =====
__pycache__/
*.pyc
*.pyo

# ===== 本地子仓库（hj/ 是本地独立 git 仓库，不纳入主仓） =====
/hj/

# ===== SQL / Python 脚本不纳入版本控制（本地脚本，不提交远程） =====
*.sql
*.py
# 例外：FastAdmin 框架安装 SQL 保留跟踪
!application/admin/command/Install/fastadmin.sql
